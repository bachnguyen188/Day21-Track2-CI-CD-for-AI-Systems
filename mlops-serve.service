[Unit]
Description=MLOps Inference API
After=network.target

[Service]
User=bach
WorkingDirectory=/home/bach
Environment="GCS_BUCKET=mlops-lab-bach-unique-id"
Environment="GOOGLE_APPLICATION_CREDENTIALS=/home/bach/sa-key.json"
ExecStart=/usr/bin/python3 -m uvicorn src.serve:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
